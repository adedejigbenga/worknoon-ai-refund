# Copy to backend/.env. Never commit real secrets.

# Backend
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
CORS_ORIGIN=http://localhost:5173

# Admin dashboard API protection (send as "x-admin-key" header)
ADMIN_API_KEY=change-me

# LLM (server-side only; never exposed to the frontend)
# Leave ANTHROPIC_API_KEY empty to run with a deterministic template fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
